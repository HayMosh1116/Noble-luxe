{
  "buildCommand": "pnpm -w run typecheck:libs && pnpm --filter @workspace/noble-luxe run build",
  "outputDirectory": "artifacts/noble-luxe/dist/public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://noble-luxe-api-and-checkout--donaldmilles56.replit.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
