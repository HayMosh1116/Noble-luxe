modules = ["nodejs-24"]

    [deployment]
    router = "application"
    deploymentTarget = "autoscale"
    build = "pnpm --filter @workspace/api-server run build && pnpm --filter @workspace/noble-luxe run build"
    run = "pnpm --filter @workspace/noble-luxe run serve"

    [deployment.postBuild]
    args = ["pnpm", "store", "prune"]
    env = { "CI" = "true" }
    